@@ -0,0 +1,126 @@
+package desync
+
+import (
+	"bytes"
+	"crypto/tls"
+	"encoding/binary"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/rs/zerolog"
+	"github.com/xvzc/spoofdpi/internal/config"
+	"github.com/xvzc/spoofdpi/internal/proto"
+)
+
+func TestRecordSplitPreservesHandshake(t *testing.T) {
+	raw := []byte(config.FakeClientHello)
+	// Upstream fake payload deliberately has an inconsistent record length.
+	binary.BigEndian.PutUint16(raw[3:5], uint16(len(raw)-5))
+	before := bytes.Clone(raw)
+	msg := proto.NewFakeTLSMessage(raw)
+	parts, err := splitTLSRecord(msg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(parts) != 2 {
+		t.Fatalf("got %d records", len(parts))
+	}
+	var payload []byte
+	for _, part := range parts {
+		if !bytes.Equal(part.Packet[:3], raw[:3]) {
+			t.Fatal("record type/version changed")
+		}
+		if int(binary.BigEndian.Uint16(part.Packet[3:5])) != len(part.Packet)-5 {
+			t.Fatal("bad record length")
+		}
+		payload = append(payload, part.Packet[5:]...)
+	}
+	start, _, _ := msg.ExtractSNIOffset()
+	if len(parts[0].Packet) != start+1 {
+		t.Fatal("boundary outside SNI")
+	}
+	if !bytes.Equal(payload, raw[5:]) || !bytes.Equal(raw, before) {
+		t.Fatal("handshake mutated")
+	}
+}
+
+func TestRecordSplitMalformedFallback(t *testing.T) {
+	for _, raw := range [][]byte{nil, {0x16}, {0x16, 3, 1, 0, 1, 1}, []byte("not TLS")} {
+		msg := proto.NewFakeTLSMessage(raw)
+		if _, err := splitTLSRecord(msg); err == nil {
+			t.Fatal("invalid record accepted")
+		}
+		parts := split(zerolog.Nop(), msg, &config.HTTPSOptions{SplitMode: config.HTTPSSplitModeRecord})
+		if len(parts) != 1 || !bytes.Equal(parts[0].Packet, raw) {
+			t.Fatal("unsafe fallback")
+		}
+	}
+}
+
+type recordConn struct {
+	net.Conn
+	first bool
+	split bool
+}
+
+func (c *recordConn) Write(p []byte) (int, error) {
+	if !c.first {
+		return c.Conn.Write(p)
+	}
+	c.first = false
+	msg, err := proto.ReadTLSMessage(bytes.NewReader(p))
+	if err != nil {
+		return 0, err
+	}
+	parts, err := splitTLSRecord(msg)
+	if err != nil {
+		return 0, err
+	}
+	for _, part := range parts {
+		if _, err = c.Conn.Write(part.Packet); err != nil {
+			return 0, err
+		}
+	}
+	if extra := p[msg.Len():]; len(extra) > 0 {
+		if _, err = c.Conn.Write(extra); err != nil {
+			return 0, err
+		}
+	}
+	c.split = true
+	return len(p), nil
+}
+func TestRecordSplitTLSHandshake(t *testing.T) {
+	for _, version := range []uint16{tls.VersionTLS12, tls.VersionTLS13} {
+		t.Run(tls.VersionName(version), func(t *testing.T) {
+			server := httptest.NewUnstartedServer(nil)
+			server.TLS = &tls.Config{MinVersion: version, MaxVersion: version}
+			server.StartTLS()
+			defer server.Close()
+			conn, err := net.DialTimeout("tcp", server.Listener.Addr().String(), time.Second)
+			if err != nil {
+				t.Fatal(err)
+			}
+			wrapped := &recordConn{Conn: conn, first: true}
+			defer wrapped.Close()
+			_ = wrapped.SetDeadline(time.Now().Add(3 * time.Second))
+			roots := server.Client().Transport.(*http.Transport).TLSClientConfig.RootCAs
+			client := tls.Client(wrapped, &tls.Config{ServerName: "example.com", RootCAs: roots, MinVersion: version, MaxVersion: version})
+			if err = client.Handshake(); err != nil {
+				t.Fatal(err)
+			}
+			if !wrapped.split {
+				t.Fatal("record splitter not exercised")
+			}
+			if _, err = io.WriteString(client, "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n"); err != nil {
+				t.Fatal(err)
+			}
+			if _, err = io.ReadAll(client); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
