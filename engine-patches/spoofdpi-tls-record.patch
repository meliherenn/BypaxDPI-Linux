+
+// splitTLSRecord preserves the ClientHello handshake bytes, placing a TLS record
+// boundary after the first SNI hostname byte (RFC 8446 section 5.1). TCP packet
+// boundaries alone may be reassembled by a middlebox. No keys or certificates
+// are changed. Missing SNI or an incomplete record falls back via split().
+func splitTLSRecord(msg *proto.TLSMessage) ([]Segment, error) {
+	raw := msg.Raw()
+	if len(raw) < 6 || raw[0] != 0x16 || raw[5] != 0x01 ||
+		int(binary.BigEndian.Uint16(raw[3:5])) != len(raw)-5 {
+		return nil, fmt.Errorf("record split requires one complete ClientHello record")
+	}
+	start, end, err := msg.ExtractSNIOffset()
+	if err != nil {
+		return nil, err
+	}
+	at := start + 1
+	if start < 5 || at >= end || end > len(raw) {
+		return nil, fmt.Errorf("SNI is too short for a record boundary")
+	}
+	first := append([]byte(nil), raw[:at]...)
+	second := append([]byte(nil), raw[:5]...)
+	second = append(second, raw[at:]...)
+	binary.BigEndian.PutUint16(first[3:5], uint16(len(first)-5))
+	binary.BigEndian.PutUint16(second[3:5], uint16(len(second)-5))
+	return []Segment{{Packet: first}, {Packet: second}}, nil
+}
diff --git a/internal/desync/tls_record_test.go b/internal/desync/tls_record_test.go
